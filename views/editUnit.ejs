<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Unit</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <div class="container my-5">
    <h2>Edit Unit Details</h2>

    <form action="/edit-unit/<%= unit._id %>" method="POST" class="card p-4 shadow-sm bg-white">

      <div class="mb-3">
        <label for="roomId" class="form-label">Room ID</label>
        <input type="text" class="form-control" id="roomId" name="roomId" required value="<%= unit.roomId %>">
      </div>

      <div class="mb-3">
        <label for="roomArea" class="form-label">Room Area (sqft)</label>
        <input type="text" class="form-control" id="roomArea" name="roomArea" required value="<%= unit.roomArea %>">
      </div>

      <div class="mb-3">
        <label for="floor" class="form-label">Floor</label>
        <input type="number" class="form-control" id="floor" name="floor" required value="<%= unit.floor %>">
      </div>

      <div class="mb-3">
        <label for="rentCost" class="form-label">Rent Cost (₹)</label>
        <input type="number" class="form-control" id="rentCost" name="rentCost" required value="<%= unit.rentCost %>">
      </div>

      <div class="mb-3">
        <label for="maintenanceCost" class="form-label">Maintenance Cost (₹)</label>
        <input type="number" class="form-control" id="maintenanceCost" name="maintenanceCost" required value="<%= unit.maintenanceCost %>">
      </div>

      <div class="mb-3">
        <label for="bescomNumber" class="form-label">BESCOM Number</label>
        <input type="text" class="form-control" id="bescomNumber" name="bescomNumber" required value="<%= unit.bescomNumber %>">
      </div>

      <div class="form-check mb-2">
        <input class="form-check-input" type="checkbox" name="hasWaterConnection" id="hasWaterConnection" <%= unit.hasWaterConnection ? 'checked' : '' %> >
        <label class="form-check-label" for="hasWaterConnection">Has Water Connection</label>
      </div>

      <div class="form-check mb-3">
        <input class="form-check-input" type="checkbox" name="hasIndependentToilet" id="hasIndependentToilet" <%= unit.hasIndependentToilet ? 'checked' : '' %> >
        <label class="form-check-label" for="hasIndependentToilet">Has Independent Toilet</label>
      </div>

      <div class="form-check mb-4">
        <input class="form-check-input" type="checkbox" name="isOccupied" id="isOccupied" <%= unit.isOccupied ? 'checked' : '' %> >
        <label class="form-check-label" for="isOccupied">Currently Occupied</label>
      </div>

      <div class="text-end">
        <button type="submit" class="btn btn-success">Update Unit</button>
      </div>

    </form>
  </div>

</body>
</html>
