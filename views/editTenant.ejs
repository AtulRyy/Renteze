<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Tenant</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <div class="container my-5">
    <h2 class="mb-4">Edit Tenant Details</h2>

    <form action="/edit-tenant/<%= tenant._id %>" method="POST" enctype="multipart/form-data" class="card p-4 shadow-sm bg-white">

      <!-- Basic info -->
      <div class="mb-3">
        <label for="name" class="form-label">Name</label>
        <input type="text" class="form-control" id="name" name="name" required value="<%= tenant.name %>">
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="email" name="email" required value="<%= tenant.email %>">
      </div>

      <div class="mb-3">
        <label for="phone" class="form-label">Phone</label>
        <input type="text" class="form-control" id="phone" name="phone" required value="<%= tenant.phone %>">
      </div>

      <!-- Business info -->
      <div class="mb-3">
        <label for="nameOfBusiness" class="form-label">Business Name</label>
        <input type="text" class="form-control" id="nameOfBusiness" name="nameOfBusiness" required value="<%= tenant.nameOfBusiness %>">
      </div>

      <div class="mb-3">
        <label for="natureOfBusiness" class="form-label">Nature of Business</label>
        <input type="text" class="form-control" id="natureOfBusiness" name="natureOfBusiness" required value="<%= tenant.natureOfBusiness %>">
      </div>

      <!-- Financials -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="rent" class="form-label">Rent (₹)</label>
          <input type="number" class="form-control" id="rent" name="rent" required value="<%= tenant.rent %>">
        </div>
        <div class="col-md-6 mb-3">
          <label for="advance" class="form-label">Advance (₹)</label>
          <input type="number" class="form-control" id="advance" name="advance" required value="<%= tenant.advance %>">
        </div>
      </div>

      <!-- Agreement -->
      <div class="row">
        <div class="col-md-6 mb-3">
          <label for="agreementStartDate" class="form-label">Agreement Start</label>
          <input type="date" class="form-control" id="agreementStartDate" name="agreementStartDate" required value="<%= tenant.agreementStartDate.toISOString().substring(0,10) %>">
        </div>
        <div class="col-md-6 mb-3">
          <label for="agreementEndDate" class="form-label">Agreement End</label>
          <input type="date" class="form-control" id="agreementEndDate" name="agreementEndDate" required value="<%= tenant.agreementEndDate.toISOString().substring(0,10) %>">
        </div>
      </div>

      <div class="mb-3">
        <label for="annualIncrement" class="form-label">Annual Increment (%)</label>
        <input type="number" class="form-control" id="annualIncrement" name="annualIncrement" required value="<%= tenant.annualIncrement %>">
      </div>

      <!-- Optional: replace existing documents -->
      <h5 class="mt-4">Replace Documents (leave blank to keep existing)</h5>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Proof of Address</label>
          <input type="file" class="form-control" name="proofOfAddress">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Proof of Business</label>
          <input type="file" class="form-control" name="proofOfBusiness">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Proof of Identity</label>
          <input type="file" class="form-control" name="proofOfIdentity">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Agreement Draft</label>
          <input type="file" class="form-control" name="agreementDraft">
        </div>
        <div class="col-md-6 mb-4">
          <label class="form-label">Agreement Copy</label>
          <input type="file" class="form-control" name="agreementCopy">
        </div>
      </div>

      <!-- Submit -->
      <div class="text-end">
        <button type="submit" class="btn btn-success">Update Tenant</button>
      </div>

    </form>
  </div>

</body>
</html>
